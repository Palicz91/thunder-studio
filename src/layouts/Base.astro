---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

import montserratLatin400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2';
import montserratLatin700 from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2';
import notoSansThaiThai400 from '@fontsource/noto-sans-thai/files/noto-sans-thai-thai-400-normal.woff2';
import notoSansThaiThai700 from '@fontsource/noto-sans-thai/files/noto-sans-thai-thai-700-normal.woff2';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogImage?: string;
}

const { title, description, lang, ogImage } = Astro.props;
const otherLang = lang === 'th' ? 'en' : 'th';
const currentPath = Astro.url.pathname;
const altPath = currentPath.replace(/^\/(th|en)/, `/${otherLang}`);
const canonicalURL = new URL(currentPath, Astro.site);
const altURL = new URL(altPath, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={otherLang} href={altURL} />
    <link rel="alternate" hreflang="x-default" href={new URL('/th' + currentPath.replace(/^\/(th|en)/, ''), Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'en_US'} />
    <meta property="og:image" content={ogImage ?? 'https://qwhacqvkppragsulrkig.supabase.co/storage/v1/object/public/thunder-studio/images/large-room-1.webp'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage ?? 'https://qwhacqvkppragsulrkig.supabase.co/storage/v1/object/public/thunder-studio/images/large-room-1.webp'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href={montserratLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserratLatin700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoSansThaiThai400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoSansThaiThai700} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f0e0e" />
    <meta name="geo.region" content="TH-10" />
    <meta name="geo.placename" content="Bang Khen, Bangkok" />
    <meta name="geo.position" content="13.8748;100.5689" />
    <meta name="ICBM" content="13.8748, 100.5689" />
  </head>
  <body class="bg-onyx text-white font-sans antialiased">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MusicVenue",
      "name": "Thunder Studio",
      "url": Astro.site?.toString().replace(/\/$/, ''),
      "description": lang === 'th'
        ? 'ห้องซ้อมดนตรีและสตูดิโอบันทึกเสียงระดับมืออาชีพ ใจกลางกรุงเทพ'
        : 'Professional music rehearsal rooms and recording studio in the heart of Bangkok.',
      "telephone": "+66635461924",
      "email": "theorn.n@thunderventuregroup.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "288, 102-103 Phahonyothin Rd",
        "addressLocality": "Bang Khen",
        "addressRegion": "Bangkok",
        "postalCode": "10220",
        "addressCountry": "TH"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 13.8748,
        "longitude": 100.5689
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "10:00",
        "closes": "22:00"
      },
      "image": "https://qwhacqvkppragsulrkig.supabase.co/storage/v1/object/public/thunder-studio/images/large-room-1.webp",
      "hasMap": "https://maps.google.com/maps?q=288+Phahonyothin+Rd+Anusawari+Bang+Khen+Bangkok+10220",
      "sameAs": [
        "https://www.facebook.com/thunderventurestudio",
        "https://www.instagram.com/thunderventure.studio"
      ],
      "taxID": "0105586164737",
      "parentOrganization": {
        "@type": "Organization",
        "name": "Thunder Venture Group",
        "url": "https://thunderventuregroup.com"
      }
    })} />
    <slot />
  </body>
</html>

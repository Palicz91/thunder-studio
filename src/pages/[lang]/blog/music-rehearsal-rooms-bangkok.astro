                  <tr class="border-t border-gray-200 bg-gray-50"><td class="px-5 py-3 font-medium">Soundproofing</td><td class="px-5 py-3 text-gray-700">Full soundproofing</td><td class="px-5 py-3 text-gray-700">Full soundproofing</td><td class="px-5 py-3 text-gray-700">Soundproofing + acoustic treatment</td></tr>

---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'th' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const IMG = 'https://qwhacqvkppragsulrkig.supabase.co/storage/v1/object/public/thunder-studio/images';

const title = lang === 'th'
  ? 'บริการทั้งหมด — ห้องซ้อม ห้องอัดเสียง มิกซ์เสียง | Thunder Studio'
  : 'Our Services — Rehearsal, Recording, Mixing & Mastering | Thunder Studio';
const description = lang === 'th'
  ? 'บริการของ Thunder Studio: ห้องซ้อมดนตรีสำหรับวงเต็มและกลุ่มเล็ก ห้องอัดเสียง มิกซ์เสียง และมาสเตอร์ ครบจบในที่เดียว บางเขน กรุงเทพ'
  : 'Thunder Studio services: band rehearsal rooms for full bands and small groups, recording studio, mixing, and mastering — all under one roof in Bang Khen, Bangkok.';
---

<Base {title} {description} {lang} ogImage={`${IMG}/hallway.webp`}>
  <SiteHeader {lang} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "author": { "@type": "Organization", "name": "Thunder Studio" },
    "publisher": {
      "@type": "Organization",
      "name": "Thunder Studio",
      "url": "https://thundermusicstudio.com",
    },
    "image": `${IMG}/hallway.webp`,
    "mainEntityOfPage": `https://thundermusicstudio.com/${lang}/services`,
    "inLanguage": lang === 'th' ? 'th-TH' : 'en-US',
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": t('breadcrumb.home'), "item": `https://thundermusicstudio.com/${lang}` },
      { "@type": "ListItem", "position": 2, "name": lang === 'th' ? 'บริการ' : 'Services' },
    ],
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": lang === 'th' ? [
      { "@type": "Question", "name": "Thunder Studio มีบริการอะไรบ้าง?", "acceptedAnswer": { "@type": "Answer", "text": "มีห้องซ้อมดนตรี 2 ห้อง (Studio 1 สำหรับวงเต็ม 6-10 คน และ Studio 2 สำหรับกลุ่มเล็ก 2-4 คน) พร้อม Control Room สำหรับอัดเสียง มิกซ์ และมาสเตอร์" }},
      { "@type": "Question", "name": "จองห้องยังไง?", "acceptedAnswer": { "@type": "Answer", "text": "จองผ่านเว็บไซต์หรือ LINE @thunderstudio แจ้งจำนวนคนและช่วงเวลาที่ต้องการ" }},
      { "@type": "Question", "name": "ต้องเอาอุปกรณ์ไปเองไหม?", "acceptedAnswer": { "@type": "Answer", "text": "อุปกรณ์หลักมีให้ในห้อง ทั้ง Marshall amps กลองชุด PA system และไมค์ เอาเฉพาะกีตาร์หรือเบสของตัวเองมาก็พอ" }},
      { "@type": "Question", "name": "เปิดกี่โมง?", "acceptedAnswer": { "@type": "Answer", "text": "เปิดทุกวัน 10:00-22:00 ที่บางเขน กรุงเทพ มีที่จอดรถ" }},
    ] : [
      { "@type": "Question", "name": "What services does Thunder Studio offer?", "acceptedAnswer": { "@type": "Answer", "text": "Two rehearsal rooms (Studio 1 for full bands of 6-10, Studio 2 for small groups of 2-4) plus a Control Room for recording, mixing, and mastering." }},
      { "@type": "Question", "name": "How do I book?", "acceptedAnswer": { "@type": "Answer", "text": "Book through the website or LINE @thunderstudio. Share your group size and preferred time slot." }},
      { "@type": "Question", "name": "Do I need to bring equipment?", "acceptedAnswer": { "@type": "Answer", "text": "Core equipment is included: Marshall amps, drum kit, PA system, and mics. Just bring your own guitar or bass." }},
      { "@type": "Question", "name": "What are the opening hours?", "acceptedAnswer": { "@type": "Answer", "text": "Open daily 10:00 AM to 10:00 PM in Bang Khen, Bangkok. Parking available." }},
    ],
  })} />

  <section class="relative min-h-[45vh] flex items-end overflow-hidden grain">
    <div class="absolute inset-0">
      <img src={`${IMG}/hallway.webp`} alt={lang === 'th' ? 'Thunder Studio ทางเดินภายใน' : 'Thunder Studio hallway'} class="w-full h-full object-cover opacity-20" fetchpriority="high" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-onyx via-onyx/60 to-onyx/80"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 pt-32 pb-14 w-full">
      <nav class="text-[13px] text-white/50 mb-6">
        <a href={`/${lang}`} class="hover:text-white transition-colors">{t('breadcrumb.home')}</a>
        <span class="mx-2">/</span>
        <span class="text-white/80">{lang === 'th' ? 'บริการ' : 'Services'}</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.02em] uppercase">
        {lang === 'th' ? 'บริการทั้งหมด' : 'Our Services'}
      </h1>
      <p class="text-base md:text-lg text-white/60 mt-4 max-w-xl leading-relaxed">
        {lang === 'th'
          ? 'Thunder Studio มีห้องซ้อมดนตรี 2 ขนาด ห้องบันทึกเสียง และบริการมิกซ์มาสเตอร์ อุปกรณ์ครบ กันเสียงรอบด้าน ครบจบในอาคารเดียว ที่บางเขน กรุงเทพ'
          : 'Thunder Studio offers two rehearsal rooms, a recording studio, and mixing & mastering services — fully equipped, fully soundproofed, all under one roof in Bang Khen, Bangkok.'}
      </p>
    </div>
  </section>

  <section class="bg-clinical text-onyx py-20">
    <div class="max-w-[1200px] mx-auto px-6">

      <div class="reveal grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-[-0.02em]">
            {lang === 'th' ? 'ห้องซ้อมดนตรี — วงเต็ม' : 'Band Rehearsal — Full Band'}
          </h2>
          <p class="text-[16px] text-gray-700 leading-relaxed mt-4">
            {lang === 'th'
              ? 'Studio 1 รองรับ 6-10 คน พร้อม Marshall amps กลองชุดเต็ม PA system และไมค์ กันเสียงรอบด้าน เหมาะสำหรับวงเต็มที่ต้องการซ้อมเต็มอัตรา ไม่ว่าจะเตรียมตัวก่อนโชว์หรือซ้อมประจำสัปดาห์'
              : 'Studio 1 fits 6-10 people with Marshall amps, a full drum kit, PA system, and mics. Fully soundproofed. Built for full bands preparing for shows or running weekly rehearsals.'}
          </p>
          <div class="flex gap-4 mt-6">
            <a href={`/${lang}/rooms/large-room`} class="inline-block bg-onyx text-white rounded-xl px-6 py-3 text-[14px] font-semibold hover:bg-onyx/80 transition-colors">
              {lang === 'th' ? 'ดู Studio 1' : 'View Studio 1'}
            </a>
            <a href={`/${lang}/blog/how-to-prepare-for-band-rehearsal`} class="inline-block border border-gray-300 rounded-xl px-6 py-3 text-[14px] font-semibold text-gray-700 hover:border-onyx hover:text-onyx transition-colors">
              {lang === 'th' ? 'เตรียมตัวยังไง' : 'How to prepare'}
            </a>
          </div>
        </div>
        <img src={`${IMG}/large-room-1.webp`} alt={lang === 'th' ? 'Studio 1 ห้องซ้อมใหญ่' : 'Studio 1 large rehearsal room'} class="w-full h-[280px] object-cover rounded-2xl border border-gray-300" loading="lazy" />
      </div>

      <hr class="my-16 border-gray-200" />

      <div class="reveal grid md:grid-cols-2 gap-10 items-center">
        <img src={`${IMG}/small-room-1.webp`} alt={lang === 'th' ? 'Studio 2 ห้องซ้อมเล็ก' : 'Studio 2 small rehearsal room'} class="w-full h-[280px] object-cover rounded-2xl border border-gray-300 md:order-first" loading="lazy" />
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-[-0.02em]">
            {lang === 'th' ? 'ห้องซ้อม — เดี่ยวและกลุ่มเล็ก' : 'Practice Room — Solo & Small Groups'}
          </h2>
          <p class="text-[16px] text-gray-700 leading-relaxed mt-4">
            {lang === 'th'
              ? 'Studio 2 รองรับ 2-4 คน พร้อมกีตาร์แอมป์ PA system และไมค์ พื้นที่พอดี ไม่ต้องจ่ายค่าห้องใหญ่ เหมาะสำหรับซ้อมเดี่ยว ดูโอ้ หรือวงเล็กที่ต้องการห้องกันเสียงคุณภาพดี'
              : 'Studio 2 fits 2-4 people with guitar amp, PA system, and mics. Right-sized for solo practice, duos, or small groups who want quality soundproofing without paying for a large room.'}
          </p>
          <div class="flex gap-4 mt-6">
            <a href={`/${lang}/rooms/small-room`} class="inline-block bg-onyx text-white rounded-xl px-6 py-3 text-[14px] font-semibold hover:bg-onyx/80 transition-colors">
              {lang === 'th' ? 'ดู Studio 2' : 'View Studio 2'}
            </a>
            <a href={`/${lang}/blog/choosing-room-size`} class="inline-block border border-gray-300 rounded-xl px-6 py-3 text-[14px] font-semibold text-gray-700 hover:border-onyx hover:text-onyx transition-colors">
              {lang === 'th' ? 'เลือกขนาดห้อง' : 'Choosing room size'}
            </a>
          </div>
        </div>
      </div>

      <hr class="my-16 border-gray-200" />

      <div class="reveal grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-[-0.02em]">
            {lang === 'th' ? 'บันทึกเสียง' : 'Recording'}
          </h2>
          <p class="text-[16px] text-gray-700 leading-relaxed mt-4">
            {lang === 'th'
              ? 'Control Room พร้อม mixing console, DAW workstation และ studio monitors อัดเสียงได้ทั้งวงเต็มและเดี่ยว ห้องออกแบบมาเพื่อการบันทึกเสียงโดยเฉพาะ มี acoustic treatment ควบคุมเสียงสะท้อน ให้ได้เสียงที่สะอาดและรายละเอียดคมชัด'
              : 'The Control Room is equipped with a mixing console, DAW workstation, and studio monitors. Designed for recording with proper acoustic treatment to control reflections and deliver clean, detailed audio.'}
          </p>
          <div class="flex gap-4 mt-6">
            <a href={`/${lang}/rooms/control-room`} class="inline-block bg-onyx text-white rounded-xl px-6 py-3 text-[14px] font-semibold hover:bg-onyx/80 transition-colors">
              {lang === 'th' ? 'ดู Control Room' : 'View Control Room'}
            </a>
            <a href={`/${lang}/blog/how-to-choose-recording-studio`} class="inline-block border border-gray-300 rounded-xl px-6 py-3 text-[14px] font-semibold text-gray-700 hover:border-onyx hover:text-onyx transition-colors">
              {lang === 'th' ? 'เลือกสตูดิโอยังไง' : 'How to choose'}
            </a>
          </div>
        </div>
        <img src={`${IMG}/control-room-1.webp`} alt={lang === 'th' ? 'Control Room ห้องอัดเสียง' : 'Control Room recording studio'} class="w-full h-[280px] object-cover rounded-2xl border border-gray-300" loading="lazy" />
      </div>

      <hr class="my-16 border-gray-200" />

      <div class="reveal grid md:grid-cols-2 gap-10 items-center">
        <img src={`${IMG}/control-room-1.webp`} alt={lang === 'th' ? 'มิกซ์เสียงที่ Thunder Studio' : 'Mixing at Thunder Studio'} class="w-full h-[280px] object-cover rounded-2xl border border-gray-300 md:order-first" loading="lazy" />
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-[-0.02em]">
            {lang === 'th' ? 'มิกซ์เสียง & มาสเตอร์' : 'Mixing & Mastering'}
          </h2>
          <p class="text-[16px] text-gray-700 leading-relaxed mt-4">
            {lang === 'th'
              ? 'มิกซ์และมาสเตอร์ต่อเนื่องจากการอัดได้เลยใน Control Room เดียวกัน ไม่ต้องย้ายไฟล์ไปที่อื่น ได้ยินเสียงจริงจาก studio monitors คุณภาพสูง ประหยัดเวลาและรักษาคุณภาพเสียงตลอดกระบวนการ'
              : 'Mix and master in the same Control Room right after recording — no need to transfer files elsewhere. Hear the real sound through quality studio monitors. Saves time and maintains audio quality throughout the entire process.'}
          </p>
          <div class="flex gap-4 mt-6">
            <a href={`/${lang}/rooms/control-room`} class="inline-block bg-onyx text-white rounded-xl px-6 py-3 text-[14px] font-semibold hover:bg-onyx/80 transition-colors">
              {lang === 'th' ? 'ดู Control Room' : 'View Control Room'}
            </a>
            <a href={`/${lang}/blog/recording-studio-guide`} class="inline-block border border-gray-300 rounded-xl px-6 py-3 text-[14px] font-semibold text-gray-700 hover:border-onyx hover:text-onyx transition-colors">
              {lang === 'th' ? 'คู่มืออัดเสียง' : 'Recording guide'}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-onyx py-20 grain">
    <div class="max-w-[1200px] mx-auto px-6">
      <h2 class="reveal text-3xl font-bold tracking-[-0.02em] uppercase">
        {lang === 'th' ? 'ทำไมต้อง Thunder Studio' : 'Why Thunder Studio'}
      </h2>
      <div class="grid md:grid-cols-3 gap-8 mt-12">
        {[
          {
            title: lang === 'th' ? 'อุปกรณ์ครบ ไม่ต้องหิ้ว' : 'Fully Equipped',
            desc: lang === 'th' ? 'Marshall amps, กลองชุด, PA system, ไมค์, mixing console พร้อมทุกห้อง เอาแค่กีตาร์หรือเบสมา' : 'Marshall amps, drum kit, PA system, mics, mixing console — all rooms ready. Just bring your guitar or bass.',
          },
          {
            title: lang === 'th' ? 'กันเสียงรอบด้าน' : 'Full Soundproofing',
            desc: lang === 'th' ? 'ทุกห้องกันเสียง เล่นเต็มเสียงได้โดยไม่รบกวนใคร Control Room มี acoustic treatment เพิ่มเติม' : 'Every room is soundproofed — play at full volume without disturbing anyone. Control Room has additional acoustic treatment.',
          },
          {
            title: lang === 'th' ? 'ครบจบในที่เดียว' : 'All Under One Roof',
            desc: lang === 'th' ? 'ซ้อม อัดเสียง มิกซ์ มาสเตอร์ ทำได้หมดในอาคารเดียว ไม่ต้องย้ายที่' : 'Rehearse, record, mix, and master — all in one building. No need to move between locations.',
          },
        ].map((feature, idx) => (
          <div class="reveal p-7 border border-white/10 rounded-2xl" style={`transition-delay: ${idx * 100}ms;`}>
            <h3 class="text-[17px] font-bold">{feature.title}</h3>
            <p class="text-[13px] text-white/50 leading-relaxed mt-3">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-clinical text-onyx py-16">
    <div class="max-w-[720px] mx-auto px-6">
      <h2 class="reveal text-2xl font-bold tracking-[-0.02em] mb-8">
        {lang === 'th' ? 'คำถามที่พบบ่อย' : 'Frequently Asked Questions'}
      </h2>

      {lang === 'th' ? (
        <div class="reveal space-y-4">
          <p><strong>Thunder Studio มีบริการอะไรบ้าง?</strong><br />มีห้องซ้อมดนตรี 2 ห้อง (Studio 1 สำหรับวงเต็ม 6-10 คน และ Studio 2 สำหรับกลุ่มเล็ก 2-4 คน) พร้อม Control Room สำหรับอัดเสียง มิกซ์ และมาสเตอร์</p>

          <p><strong>จองห้องยังไง?</strong><br />จองผ่านเว็บไซต์หรือ LINE @thunderstudio แจ้งจำนวนคนและช่วงเวลาที่ต้องการ</p>

          <p><strong>ต้องเอาอุปกรณ์ไปเองไหม?</strong><br />อุปกรณ์หลักมีให้ในห้อง ทั้ง Marshall amps กลองชุด PA system และไมค์ เอาเฉพาะกีตาร์หรือเบสของตัวเองมาก็พอ</p>

          <p><strong>เปิดกี่โมง?</strong><br />เปิดทุกวัน 10:00-22:00 ที่บางเขน กรุงเทพ มีที่จอดรถ ดู<a href={`/${lang}/location`}>แผนที่</a>ได้เลย</p>
        </div>
      ) : (
        <div class="reveal space-y-4">
          <p><strong>What services does Thunder Studio offer?</strong><br />Two rehearsal rooms (Studio 1 for full bands of 6-10, Studio 2 for small groups of 2-4) plus a Control Room for recording, mixing, and mastering.</p>

          <p><strong>How do I book?</strong><br />Book through the website or LINE @thunderstudio. Share your group size and preferred time slot.</p>

          <p><strong>Do I need to bring equipment?</strong><br />Core equipment is included: Marshall amps, drum kit, PA system, and mics. Just bring your own guitar or bass.</p>

          <p><strong>What are the opening hours?</strong><br />Open daily 10:00 AM to 10:00 PM in Bang Khen, Bangkok. Parking available. See the <a href={`/${lang}/location`}>location page</a> for directions.</p>
        </div>
      )}

      <div class="reveal mt-8 text-center">
        <p class="text-[15px] text-gray-600 mb-4">
          {lang === 'th'
            ? 'อยากรู้เรื่องห้องซ้อมเพิ่มเติม อ่านได้ที่'
            : 'Want to learn more about rehearsal rooms? Read our guides:'}
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={`/${lang}/blog/what-is-a-rehearsal-room`} class="text-[14px] text-gray-700 underline underline-offset-2 decoration-gray-300 hover:decoration-onyx transition-colors">
            {lang === 'th' ? 'ห้องซ้อมดนตรีคืออะไร' : 'What is a rehearsal room?'}
          </a>
          <span class="text-gray-300">|</span>
          <a href={`/${lang}/blog/music-rehearsal-rooms-bangkok`} class="text-[14px] text-gray-700 underline underline-offset-2 decoration-gray-300 hover:decoration-onyx transition-colors">
            {lang === 'th' ? 'ห้องซ้อมในกรุงเทพ' : 'Rehearsal rooms in Bangkok'}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-clinical text-onyx py-16 border-t border-gray-200">
    <div class="max-w-[1200px] mx-auto px-6 text-center">
      <h2 class="reveal text-3xl font-bold tracking-[-0.02em]">{t('hero.cta.book')}</h2>
      <p class="reveal text-[15px] text-gray-600 mt-3 max-w-lg mx-auto" style="transition-delay: 80ms;">
        {lang === 'th'
          ? 'เลือกห้องที่เหมาะกับวง จองวันและเวลาที่สะดวก'
          : 'Choose the right room for your band. Book your preferred date and time.'}
      </p>
      <a href={`/${lang}/#booking`} class="reveal inline-block mt-6 bg-onyx text-white rounded-xl px-8 py-4 text-[15px] font-semibold hover:bg-onyx/80 transition-colors" style="transition-delay: 160ms;">
        {t('hero.cta.book')}
      </a>
    </div>
  </section>

  <SiteFooter {lang} />
  <ScrollReveal />
</Base>

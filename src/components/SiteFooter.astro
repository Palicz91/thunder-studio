---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="bg-onyx border-t border-white/10 relative overflow-hidden grain">
  <div class="relative max-w-[1200px] mx-auto px-6 pt-16 pb-7">
    <div class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr_1fr] gap-10">
      <div>
        <div class="flex items-center gap-3 mb-5">
          <svg viewBox="0 0 32 32" class="w-6 h-8" fill="none">
            <path d="M 20.71 11.21 L 10.98 23.39 C 10.94 23.44 10.87 23.46 10.80 23.44 C 10.71 23.42 10.66 23.32 10.68 23.23 L 13.39 13.61 C 13.41 13.54 13.36 13.48 13.29 13.48 L 8.17 13.40 C 8.10 13.40 8.06 13.33 8.09 13.28 L 13.19 3.89 C 13.22 3.85 13.26 3.83 13.31 3.83 L 18.58 4.04 C 18.63 4.04 18.66 4.09 18.63 4.13 L 14.91 10.93 C 14.88 10.97 14.92 11.03 14.97 11.03 L 20.67 11.13 C 20.71 11.13 20.73 11.18 20.71 11.21 M 25.57 13.94 L 22.76 10.85 L 23.64 9.17 C 23.93 8.61 24.08 8.00 24.08 7.37 L 24.08 7.10 C 24.08 6.84 23.98 6.58 23.80 6.39 L 20.63 3.06 C 20.38 2.81 20.11 2.59 19.81 2.40 C 19.47 2.19 19.09 2.08 18.69 2.07 L 13.50 2.00 C 13.10 2.00 12.71 2.10 12.37 2.30 L 12.23 2.38 C 11.88 2.58 11.60 2.88 11.41 3.24 L 10.70 4.57 L 6.46 12.32 C 6.18 12.83 6.04 13.40 6.07 13.98 C 6.09 14.53 6.31 15.06 6.69 15.46 L 9.85 18.81 L 8.66 23.50 C 8.58 23.78 8.55 24.08 8.57 24.38 L 8.58 24.51 C 8.60 24.99 8.80 25.44 9.14 25.78 L 13.00 29.71 C 13.19 29.90 13.45 30.00 13.71 30.00 L 14.34 30.00 C 14.62 30.00 14.88 29.88 15.05 29.66 L 25.54 16.53 C 25.80 16.20 25.95 15.78 25.95 15.36 L 25.96 14.95 C 25.96 14.58 25.82 14.22 25.57 13.94" fill="currentColor"/>
          </svg>
          <div>
            <div class="text-[17px] font-bold tracking-[0.05em] leading-none">THUNDER</div>
            <div class="text-[6.5px] font-semibold tracking-[0.19em] text-white/50 mt-1">STUDIO</div>
          </div>
        </div>
        <p class="text-[15px] leading-relaxed text-white/80 max-w-[260px]">{t('footer.tagline')}</p>

        <div class="mt-6 text-[13px] leading-[1.9] text-white/60">
          <div><span class="text-white/42">{t('contact.phone.label')} · </span><a href={`tel:${t('phone').replace(/\s/g, '')}`} class="hover:text-white transition-colors">{t('phone')}</a></div>
          <div><span class="text-white/42">{lang === 'th' ? 'อีเมล' : 'Email'} · </span><a href={`mailto:${t('email')}`} class="hover:text-white transition-colors">{t('email')}</a></div>
          <div><span class="text-white/42">{t('contact.address.label')} · </span><a href="https://maps.app.goo.gl/6j75idTgvQCsG9HL8" target="_blank" rel="noopener" class="hover:text-white transition-colors">{t('address')}</a></div>
        </div>

        <div class="flex gap-3.5 mt-5">
          <a href="https://www.facebook.com/thunderventurestudio" target="_blank" rel="noopener" aria-label="Facebook" class="text-white/50 hover:text-white transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/thunderventure.studio" target="_blank" rel="noopener" aria-label="Instagram" class="text-white/50 hover:text-white transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href={`https://line.me/R/ti/p/${t('line')}`} target="_blank" rel="noopener" aria-label="LINE" class="text-white/50 hover:text-white transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
          </a>
        </div>
      </div>

      <div>
        <div class="text-[11px] font-semibold tracking-[0.13em] text-white/42 mb-4">{t('footer.nav')}</div>
        <div class="flex flex-col gap-3">
          <a href={`/${lang}/#rooms`} class="text-[14px] text-white/78 hover:text-white transition-colors">{t('nav.rooms')}</a>
          <a href={`/${lang}/services`} class="text-[14px] text-white/78 hover:text-white transition-colors">{lang === 'th' ? 'บริการ' : 'Services'}</a>
          <a href={`/${lang}/about`} class="text-[14px] text-white/78 hover:text-white transition-colors">{t('nav.about')}</a>
          <a href={`/${lang}/location`} class="text-[14px] text-white/78 hover:text-white transition-colors">{t('nav.location')}</a>
          <a href={`/${lang}/blog`} class="text-[14px] text-white/78 hover:text-white transition-colors">{lang === 'th' ? 'บล็อก' : 'Blog'}</a>
          <a href={`/${lang}/#booking`} class="text-[14px] text-white/78 hover:text-white transition-colors">{t('nav.booking')}</a>
          <a href={`/${lang}/#contact`} class="text-[14px] text-white/78 hover:text-white transition-colors">{t('nav.contact')}</a>
        </div>
      </div>

      <div>
        <div class="text-[11px] font-semibold tracking-[0.13em] text-white/42 mb-4">{t('footer.company')}</div>
        <div class="flex flex-col gap-3">
          <a href="https://thunderventuregroup.com" target="_blank" rel="noopener" class="text-[14px] text-white/78 hover:text-white transition-colors">{t('footer.parent')}</a>
          <a href="https://www.facebook.com/thunderventurezone" target="_blank" rel="noopener" class="text-[14px] text-white/78 hover:text-white transition-colors">Thunder Zone</a>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="text-[12px] text-white/42 tracking-[0.02em]">
        &copy; {new Date().getFullYear()} {lang === 'th' ? 'Thunder Studio — Thunder Venture Group สงวนลิขสิทธิ์' : 'Thunder Studio — Thunder Venture Group. All rights reserved.'}
        <span class="mx-2">&middot;</span>
        <a href={`/${lang}/privacy`} class="text-white/55 hover:text-white transition-colors">{t('footer.privacy')}</a>
        <span class="mx-2">&middot;</span>
        <a href={`/${lang}/terms`} class="text-white/55 hover:text-white transition-colors">{t('footer.terms')}</a>
      </div>
    </div>
  </div>
</footer>
